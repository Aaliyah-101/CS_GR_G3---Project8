# Copy this file to .env (local dev) and set the real values on your
# hosting platform (Vercel/Netlify/etc.) when deploying.

# Base URL of your FastAPI backend, no trailing slash.
# Local dev default (matches api.js fallback): http://127.0.0.1:8000
# Once deployed, e.g.: https://your-backend.onrender.com
VITE_API_BASE_URL=http://127.0.0.1:8000